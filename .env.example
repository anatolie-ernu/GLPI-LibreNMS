# Canonical configuration for docker-compose.yml
# Copy to .env and never commit the real .env file.

COMPOSE_PROJECT_NAME=glpi-librenms
TZ=Europe/Chisinau
PUID=1000
PGID=1000

# DNS names used by NPM auto-discovery.
# Replace example.internal with your internal DNS domain.
DOMAIN_NAME=example.internal
GLPI_HOSTNAME=glpi
LIBRENMS_HOSTNAME=librenms

# Host bindings.
# Direct GLPI/LibreNMS ports are loopback-only by default.
DIRECT_BIND_IP=127.0.0.1
GLPI_HTTP_PORT=8081
LIBRENMS_HTTP_PORT=8000

# Nginx Proxy Manager.
NPM_IMAGE=jc21/nginx-proxy-manager:latest
NPM_PROXY_BIND_IP=0.0.0.0
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_BIND_IP=127.0.0.1
NPM_ADMIN_PORT=81
NPM_DISABLE_IPV6=true

# Auto-discovery is disabled by default.
# After first NPM login/change of credentials, set the NPM API credentials below
# and set AUTO_DISCOVERY_ENABLED=true.
AUTO_DISCOVERY_ENABLED=false
NPM_API_EMAIL=
NPM_API_PASSWORD=
DISCOVERY_INTERVAL=300
LOG_LEVEL=INFO

# Docker images.
GLPI_IMAGE=glpi/glpi:11
GLPI_DB_IMAGE=mysql:8.4
LIBRENMS_IMAGE=librenms/librenms:latest
LIBRENMS_DB_IMAGE=mariadb:11.4
REDIS_IMAGE=redis:7.2-alpine
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:latest

# GLPI database.
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=CHANGE_ME_GLPI_DB_PASSWORD
GLPI_CRONTAB_ENABLED=1
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false

# LibreNMS database/runtime.
LIBRENMS_DB_NAME=librenms
LIBRENMS_DB_USER=librenms
LIBRENMS_DB_PASSWORD=CHANGE_ME_LIBRENMS_DB_PASSWORD
LIBRENMS_MEMORY_LIMIT=512M
LIBRENMS_MAX_INPUT_VARS=2000
LIBRENMS_UPLOAD_MAX_SIZE=32M
LIBRENMS_OPCACHE_MEM_SIZE=256

# Backups.
BACKUP_DIR=/opt/backups/glpi-librenms
