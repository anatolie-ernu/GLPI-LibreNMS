# ============================================================================
# GLPI-LibreNMS + Nginx Proxy Manager Configuration
#
# COPY TO .env și editează cu valorile tale
# cp .env.example .env
#
# ============================================================================

# ============================================================================
# DOMAIN & HOSTNAME CONFIGURATION
# ============================================================================

# Domain suffix (e.g., .local, .internal, .corp)
DOMAIN_NAME=local

# Hostname-uri pentru servicii
GLPI_HOSTNAME=glpi
LIBRENMS_HOSTNAME=librenms
NPM_HOSTNAME=npm

# Resulting domains:
# GLPI:      glpi.local
# LibreNMS:  librenms.local
# NPM Admin: npm.local

# ============================================================================
# NGINX PROXY MANAGER CREDENTIALS
# ============================================================================

# Admin email pentru NPM
NPM_ADMIN_EMAIL=admin@ernu.md

# Admin password pentru NPM (SCHIMBĂ LA PRIMA LOGARE!)
NPM_ADMIN_PASSWORD=Npm@ernu2025!

# ============================================================================
# DATABASE CREDENTIALS
# ============================================================================

# MySQL Root Password (SCHIMBĂ ÎN PRODUCTION!)
MYSQL_ROOT_PASSWORD=root_secure_pass

# GLPI Database Password
GLPI_DB_PASSWORD=glpi_secure_pass

# LibreNMS Database Password
LIBRENMS_DB_PASSWORD=librenms_secure_pass

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# GLPI Application Domain
GLPI_DOMAIN=glpi.local

# LibreNMS Application URL
LIBRENMS_URL=http://librenms.local

# Timezone
TZ=Europe/Bucharest

# ============================================================================
# NOTES
# ============================================================================

# 1. Acest fișier e generat automat de install.sh
# 2. Pentru configurare manuală: editează și copiază în .env
# 3. docker-compose va folosi valorile din .env
# 4. ⚠️ SCHIMBĂ TOATE PAROLELE DEFAULT ÎNAINTE DE PRODUCTION!
# 5. Keepa acest fișier în .gitignore (nu commita parolele!)

# Generated: $(date)
